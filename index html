<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cryptia | Automated Algorithmic Engine</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        body { background: #05070b; color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow-x: hidden; }

        /* Canvas Background for 3D Galaxy */
        #galaxy-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; }

        /* Main Scrollable Content Container */
        .content { position: relative; z-index: 2; width: 100%; }

        /* Hero Section */
        .hero {
            height: 100vh; display: flex; flex-direction: column;
            justify-content: center; align-items: center; text-align: center; padding: 0 20px;
        }
        .hero h1 { font-size: 4rem; font-weight: 800; letter-spacing: -1.5px; text-shadow: 0 0 25px rgba(0, 230, 118, 0.4); }
        .hero p { color: #8a99ad; margin-top: 15px; max-width: 550px; font-size: 1.2rem; line-height: 1.5; }
        .cta-btn {
            margin-top: 30px; padding: 15px 32px; background: #00e676; color: #000000;
            font-weight: bold; font-size: 1rem; border-radius: 8px; border: none; cursor: pointer;
            text-decoration: none; box-shadow: 0 0 30px rgba(0, 230, 118, 0.4); transition: all 0.3s ease;
        }
        .cta-btn:hover { transform: translateY(-3px); box-shadow: 0 0 45px rgba(0, 230, 118, 0.7); }

        /* Section Layouts */
        .section { max-width: 1100px; margin: 0 auto; padding: 100px 20px; text-align: center; }
        .section-title { font-size: 2.5rem; color: #ffffff; margin-bottom: 15px; }
        .section-subtitle { color: #00e676; font-size: 1rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 50px; }

        /* Grid for Capabilities */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .card {
            background: rgba(21, 26, 35, 0.75); border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px); padding: 35px 25px; border-radius: 16px; text-align: left;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }
        .card:hover { transform: translateY(-5px); border-color: #00e676; }
        .card h3 { font-size: 1.3rem; color: #00e676; margin-bottom: 12px; }
        .card p { color: #a0aec0; font-size: 0.95rem; line-height: 1.6; }

        /* Form / Pre-Order Box */
        .waitlist-box {
            background: rgba(21, 26, 35, 0.85); border: 1px solid rgba(0, 230, 118, 0.3);
            border-radius: 20px; padding: 50px; max-width: 600px; margin: 0 auto;
        }
        .waitlist-box input[type="email"] {
            width: 100%; padding: 15px; margin: 20px 0; border-radius: 8px;
            border: 1px solid #2d3748; background: #0b0e14; color: #ffffff; font-size: 1rem;
        }
        .waitlist-box input[type="email"]:focus { outline: none; border-color: #00e676; }

        footer { text-align: center; padding: 40px; color: #4a5568; font-size: 0.9rem; }
    </style>
</head>
<body>

    <!-- 3D Particle Galaxy Canvas Background -->
    <div id="galaxy-container"></div>

    <div class="content">
        <!-- Hero Section -->
        <section class="hero">
            <h1>CRYPTIA ENGINE</h1>
            <p>Zero-custody, high-precision algorithmic strategy engine. Built for automated execution across crypto & forex markets.</p>
            <a href="#waitlist" class="cta-btn">Join Pre-Order Waitlist</a>
        </section>

        <!-- Capabilities Section -->
        <section class="section">
            <div class="section-subtitle">System Capabilities</div>
            <h2 class="section-title">Engineered for Autonomous Performance</h2>
            <div class="grid">
                <div class="card">
                    <h3>Non-Custodial Architecture</h3>
                    <p>Cryptia never touches or holds user funds. Connect your broker via trade-only API keys with zero withdrawal rights for maximum security.</p>
                </div>
                <div class="card">
                    <h3>Hardcoded Risk Caps</h3>
                    <p>Enforces a maximum 1.5% capital risk per trade and an integrated global stop-loss to protect portfolios during extreme market volatility.</p>
                </div>
                <div class="card">
                    <h3>24/7 Cloud Worker Loops</h3>
                    <p>Executes continuous algorithmic strategies on dedicated background cloud infrastructure—unaffected by local power or network drops.</p>
                </div>
                <div class="card">
                    <h3>Sandbox Paper-Trading</h3>
                    <p>Test real market signals in a risk-free simulated environment before deploying real capital to live broker connections.</p>
                </div>
            </div>
        </section>

        <!-- Pre-Order / Waitlist Section -->
        <section class="section" id="waitlist">
            <div class="waitlist-box">
                <h2 style="font-size: 2rem; margin-bottom: 10px;">Reserve Early Access</h2>
                <p style="color: #a0aec0;">The first 50 beta traders receive full sandbox access and subscription priority.</p>
                <form action="#" method="POST" onsubmit="alert('Thank you for joining the Cryptia pre-order waitlist!'); return false;">
                    <input type="email" placeholder="Enter your business email" required>
                    <button type="submit" class="cta-btn" style="width: 100%; margin-top: 0;">Request Early Access</button>
                </form>
            </div>
        </section>

        <footer>
            &copy; 2026 Cryptia Engine. All rights reserved.
        </footer>
    </div>

    <!-- Three.js 3D Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // Set up Scene, Camera, and Renderer
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.getElementById('galaxy-container').appendChild(renderer.domElement);

        // Helper function to create circular coin textures (BTC, ETH, SOL, USDT)
        function createCoinTexture(symbol, bgColor) {
            const canvas = document.createElement('canvas');
            canvas.width = 128; canvas.height = 128;
            const ctx = canvas.getContext('2d');

            ctx.beginPath();
            ctx.arc(64, 64, 60, 0, Math.PI * 2);
            ctx.fillStyle = bgColor; ctx.fill();
            ctx.lineWidth = 6; ctx.strokeStyle = '#ffffff'; ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 42px sans-serif';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(symbol, 64, 64);

            return new THREE.CanvasTexture(canvas);
        }

        const coinTextures = [
            createCoinTexture('₿', '#f7931a'), // BTC
            createCoinTexture('Ξ', '#627eea'), // ETH
            createCoinTexture('S', '#14f195'), // SOL
            createCoinTexture('₮', '#26a17b')  // USDT
        ];

        // Generate Spiral Coin Galaxy Group
        const galaxyGroup = new THREE.Group();
        const coinCount = 350;

        for (let i = 0; i < coinCount; i++) {
            const texture = coinTextures[i % coinTextures.length];
            const material = new THREE.SpriteMaterial({ map: texture, transparent: true, opacity: 0.9 });
            const sprite = new THREE.Sprite(material);

            const radius = Math.random() * 6 + 0.5;
            const spinAngle = radius * 2.5;
            const branchAngle = ((i % 3) * 2 * Math.PI) / 3;

            sprite.position.x = Math.cos(branchAngle + spinAngle) * radius + (Math.random() - 0.5) * 0.4;
            sprite.position.y = (Math.random() - 0.5) * 0.5;
            sprite.position.z = Math.sin(branchAngle + spinAngle) * radius + (Math.random() - 0.5) * 0.4;

            const scale = Math.random() * 0.12 + 0.1;
            sprite.scale.set(scale, scale, 1);

            galaxyGroup.add(sprite);
        }

        scene.add(galaxyGroup);
        camera.position.set(0, 2, 5.5);
        camera.lookAt(0, 0, 0);

        // Continuous Animation Loop
        function animate() {
            requestAnimationFrame(animate);
            galaxyGroup.rotation.y += 0.002;
            renderer.render(scene, camera);
        }
        animate();

        // Responsive Resizing
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
